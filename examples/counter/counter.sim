use SubzeroSim.DSL

simulation "counter" do
  tick :state_reports
  start :immediate
  steps 10

  agent :counter, count: 3, backend: :bwrap, model: "minimax/minimax-m2.7" do
    skill "skills/counter.md"
    config count: 0
  end

  measure :total_count, fn states ->
    states
    |> Map.values()
    |> Enum.map(fn s -> Map.get(s, "count", 0) end)
    |> Enum.sum()
  end

  measure :max_count, fn states ->
    states
    |> Map.values()
    |> Enum.map(fn s -> Map.get(s, "count", 0) end)
    |> Enum.max(fn -> 0 end)
  end

  halt after: 10
end
