use SubzeroSim.DSL

simulation "two_teams" do
  tick :turn_based
  start :immediate
  steps 2

  agent :team_a, count: 2, backend: :bwrap, model: "minimax/minimax-m2.7" do
    skill "skills/team_a.md"
  end

  agent :team_b, count: 2, backend: :bwrap, model: "minimax/minimax-m2.7" do
    skill "skills/team_b.md"
  end

  object :scoreboard, handler: TwoTeams.Objects.Scoreboard

  connect :team_a, :scoreboard
  connect :team_b, :scoreboard

  measure :team_a_score, fn states ->
    states
    |> Enum.filter(fn {name, _} -> String.starts_with?(to_string(name), "team_a") end)
    |> Enum.map(fn {_, s} -> Map.get(s, "points_contributed", 0) end)
    |> Enum.sum()
  end

  measure :team_b_score, fn states ->
    states
    |> Enum.filter(fn {name, _} -> String.starts_with?(to_string(name), "team_b") end)
    |> Enum.map(fn {_, s} -> Map.get(s, "points_contributed", 0) end)
    |> Enum.sum()
  end

  halt after: 2
end
